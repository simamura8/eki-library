{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "eki-library-private",
  "main": "worker/index.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "preview_urls": false,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "observability": { "enabled": true },
  "ratelimits": [{ "name": "LOGIN_LIMITER", "namespace_id": "2026111101", "simple": { "limit": 10, "period": 60 } }],
  "vars": {
    "SITE_ORIGIN": "https://eki-library-private.imaron0812.workers.dev"
  }
}
